{
  "name": "evalroom",
  "version": "0.1.0",
  "description": "Human-in-the-loop quality control for LLM outputs: multi-lens review, versioned rubrics, inter-rater agreement, golden sets and gated regression runs. No bare pass rate ever leaves.",
  "keywords": [
    "llm",
    "evaluation",
    "evals",
    "human-review",
    "inter-rater-agreement",
    "fleiss-kappa",
    "cohen-kappa",
    "wilson-interval",
    "golden-set",
    "regression-testing"
  ],
  "license": "MIT",
  "author": "Mert Seker <meertseker@gmail.com>",
  "homepage": "https://github.com/meertseker/evalroom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meertseker/evalroom.git"
  },
  "bugs": {
    "url": "https://github.com/meertseker/evalroom/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "evalroom": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/support-replies/run.ts",
    "example:build": "tsx examples/support-replies/build.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
